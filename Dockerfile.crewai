FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.crewai.txt .
RUN pip install --no-cache-dir -r requirements.crewai.txt

COPY agents/crew_config.py agents/crew_config.py
COPY crewai_server.py .

EXPOSE 8001
CMD ["uvicorn", "crewai_server:app", "--host", "0.0.0.0", "--port", "8001"]
